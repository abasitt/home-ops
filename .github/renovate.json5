{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "replacements:k8s-registry-move",
    ":automergeBranch",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits",
    ":skipStatusChecks",
    ":timezone(Asia/Singapore)",
    "github>abasitt/home-ops//.github/renovate/autoMerge.json5",
    "github>abasitt/home-ops//.github/renovate/clusters.json5",
    "github>abasitt/home-ops//.github/renovate/commitMessage.json5",
    "github>abasitt/home-ops//.github/renovate/customManagers.json5",
    "github>abasitt/home-ops//.github/renovate/grafanaDashboards.json5",
    "github>abasitt/home-ops//.github/renovate/groups.json5",
    "github>abasitt/home-ops//.github/renovate/labels.json5",
    "github>abasitt/home-ops//.github/renovate/packageRules.json5",
    "github>abasitt/home-ops//.github/renovate/semanticCommits.json5"
  ],
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "suppressNotifications": ["prEditedNotification", "prIgnoreNotification"],
  "packageRules": [
    {
      "description": "Keep router DHCP on the reviewed Kea 3.0 LTS branch",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.cloudsmith.io/isc/docker/kea-dhcp4"],
      "allowedVersions": "/^3\\.0\\.\\d+$/",
      "automerge": false
    },
    {
      "description": "Use semantic versions for app-template OCI charts",
      "matchManagers": ["flux"],
      "matchPackageNames": ["ghcr.io/bjw-s/helm/app-template", "ghcr.io/bjw-s-labs/helm/app-template"],
      "versioning": "semver"
    },
    {
      "description": "Review app-template upgrades for router and cluster networking",
      "matchManagers": ["flux"],
      "matchPackageNames": ["ghcr.io/bjw-s/helm/app-template", "ghcr.io/bjw-s-labs/helm/app-template"],
      "matchFileNames": ["kubernetes/router/**", "kubernetes/neo/apps/kube-system/**"],
      "automerge": false
    }
  ],
  "ignorePaths": ["**/*.sops.*", "**/.archive/**", "**/resources/**"],
  "flux": {
    "managerFilePatterns": ["/(^|\\/)kubernetes\\/.+\\.ya?ml(?:\\.j2)?$/"]
  },
  "helm-values": {
    "managerFilePatterns": ["/(^|\\/)kubernetes\\/.+\\.ya?ml(?:\\.j2)?$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/(^|\\/)\\.taskfiles\\/.+\\.ya?ml(?:\\.j2)?$/", "/(^|\\/)ansible\\/.+\\.ya?ml(?:\\.j2)?$/", "/(^|\\/)kubernetes\\/.+\\.ya?ml(?:\\.j2)?$/"]
  }
}
