{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/kopia/"],
      "allowedVersions": "<999"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/postgresql/"],
      "allowedVersions": "<17"
    }
  ]
}
