{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/kopia/"],
      "allowedVersions": "<999"
    },
    {
      "description": "Keep PostgreSQL 16 on its legacy numbered-build tags until an explicit image-format migration",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/cloudnative-pg/postgresql"],
      "allowedVersions": "/^16\\.\\d+-\\d+$/",
      "automerge": false
    }
  ]
}
