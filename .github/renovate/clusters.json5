{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Separate PRs for main cluster",
      "matchFileNames": [
        "**/kubernetes/neo/**",
        "**/ansible/neo/**"
      ],
      "additionalBranchPrefix": "neo-",
      "commitMessageSuffix": " [neo]"
    },
    {
      "description": "Separate PRs for router cluster",
      "matchFileNames": [
        "**/kubernetes/router/**",
        "**/ansible/router/**"
      ],
      "additionalBranchPrefix": "router-",
      "commitMessageSuffix": " [router]"
    }
  ]
}
